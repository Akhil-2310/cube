# Dedicated Sepolia-only deployer. Never use a wallet that holds real funds.
DEPLOYER_PRIVATE_KEY=
INFURA_API_KEY=
# Alternatively set ALCHEMY_API_KEY or a complete SEPOLIA_RPC_URL.
ALCHEMY_API_KEY=
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=

# Five-minute demo draw. Use 86400 for a production-style daily draw.
DRAW_DURATION_SECONDS=300

# Automated keeper. Prefer a dedicated, minimally funded Sepolia account.
VAULT_ADDRESS=
KEEPER_PRIVATE_KEY=
KEEPER_CHAIN_ID=11155111
KEEPER_POLL_INTERVAL_MS=30000
KEEPER_SETTLEMENT_BATCH_SIZE=16
KEEPER_MAX_BATCHES_PER_TICK=4
KEEPER_CONFIRMATIONS=1

# Optional early harvest. closeDraw() always harvests remaining yield atomically.
KEEPER_HARVEST_BEFORE_CLOSE=false
KEEPER_HARVEST_LEAD_SECONDS=60
